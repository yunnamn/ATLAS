# Copy to .env only if overrides are needed. Run all backend commands from backend/.
ATLAS_DATABASE_URL=sqlite:///./data/atlas.db
ATLAS_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# No model credentials required. No remote extraction provider is enabled.

# Task 2: offline research demo works with these defaults. No paid API is activated.
ATLAS_LLM_ENABLED=false
# To use an already-installed local OpenAI-compatible model, explicitly configure:
# ATLAS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ATLAS_LLM_MODEL=your-installed-model
# ATLAS_LLM_JSON_MODE=json_object
# Hosted endpoints require HTTPS. Supply any ATLAS_LLM_API_KEY securely, not in Git.
ATLAS_LLM_TIMEOUT_SECONDS=20
ATLAS_LLM_RETRIES=1
ATLAS_LLM_MAX_OUTPUT_TOKENS=1800
ATLAS_RESEARCH_CACHE_SECONDS=3600
ATLAS_RESEARCH_MIN_INTERVAL=1
# Optional SearxNG JSON service, disabled when absent:
# ATLAS_SEARCH_BASE_URL=http://127.0.0.1:8888
# Supply ATLAS_SEARCH_API_KEY securely if required. Search results stay in run scope.
